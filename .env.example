# Public URL of your instance (SEO, Open Graph images and the sitemap).
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=https://paperfree-mu.vercel.app

# Link to your GitHub repository (header, footer, home page).
NEXT_PUBLIC_GITHUB_URL=https://github.com/cind3rbyte/paperfree

# Your Ko-fi page for the "☕ Buy Me a Coffee" button.
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/cind3rbyte

# Optional: additional Buy Me a Coffee link (shown in the footer when set).
NEXT_PUBLIC_BMC_URL=
