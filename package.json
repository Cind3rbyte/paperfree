{
  "name": "paperfree",
  "version": "1.0.0",
  "private": true,
  "description": "PaperFree – kostenlose, quelloffene PDF-Werkzeuge, die zu 100 % lokal im Browser laufen. Die datenschutzfreundliche Alternative zu Adobe Acrobat und ILovePDF.",
  "license": "MIT",
  "keywords": [
    "pdf",
    "pdf-merge",
    "pdf-split",
    "pdf-compress",
    "privacy",
    "nextjs",
    "pdf-lib",
    "pdfjs"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  }
}
